rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Hardened Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isAdmin() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // Properties
    match /properties/{propertyId} {
      allow read: if true; 
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // Saved Listings
    match /savedListings/{savedId} {
      allow read: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Notifications
    match /notifications/{notificationId} {
        allow read: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
        allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Property Views
    match /propertyViews/{viewId} {
        allow read: if isAdmin();
        allow create: if isSignedIn() && incoming().viewerId == request.auth.uid;
    }

    // Reports
    match /reports/{reportId} {
        allow read: if isAdmin();
        allow create: if isSignedIn() && incoming().reporterId == request.auth.uid;
    }

    // Contact Interactions
    match /contactInteractions/{interactionId} {
        allow read: if isAdmin();
        allow create: if isSignedIn() && incoming().userId == request.auth.uid;
    }

    // Conversations
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isSignedIn() && isValidId(conversationId) && (request.auth.uid in incoming().participants) && incoming().updatedAt == request.time;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow list: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants || isAdmin());
        allow create: if isSignedIn() && isValidId(messageId) && (request.auth.uid == incoming().senderId) && incoming().timestamp == request.time && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants || isAdmin());
        allow update: if isSignedIn() && (request.auth.uid != existing().senderId) && incoming().diff(existing()).affectedKeys().hasOnly(['status']) && incoming().status == 'seen';
      }
    }
  }
}
